{{ 'hooks-pages.css' | asset_url | stylesheet_tag }}

<section class="hooks-page hooks-contact-page">
  <div class="hooks-page-hero">
    <div class="page-width hooks-page-hero__inner">
      <p class="hooks-page-eyebrow">{{ section.settings.eyebrow }}</p>
      <h1 class="hooks-page-title">{{ section.settings.heading }}</h1>
      <div class="hooks-page-lead">{{ section.settings.intro }}</div>
    </div>
  </div>

  <div class="hooks-contact-content">
    <div class="page-width hooks-contact-grid">
      <div class="hooks-contact-copy">
        <h2>{{ section.settings.form_heading }}</h2>
        <div>{{ section.settings.form_intro }}</div>
        <div class="hooks-contact-promises">
          <div class="hooks-contact-promise">
            <strong>Cash on delivery</strong>
            <span>Pay when your order reaches you.</span>
          </div>
          <div class="hooks-contact-promise">
            <strong>Delivery across Lebanon</strong>
            <span>We accept orders from anywhere in Lebanon.</span>
          </div>
        </div>
      </div>

      <div class="hooks-contact-form">
        {%- form 'contact', id: 'HooksContactForm' -%}
          {%- if form.posted_successfully? -%}
            <div class="form-status form__message" tabindex="-1" autofocus>
              {{- 'icon-success.svg' | inline_asset_content -}}
              Thanks for contacting us. We’ll get back to you soon.
            </div>
          {%- elsif form.errors -%}
            <div class="form-status form__message" role="alert" tabindex="-1" autofocus>
              {{- 'icon-error.svg' | inline_asset_content -}}
              Please check the highlighted information and try again.
            </div>
          {%- endif -%}

          <div class="field">
            <input class="field__input" autocomplete="name" type="text" id="HooksContactForm-name" name="contact[Name]" value="{{ form.name }}" placeholder="Name">
            <label class="field__label" for="HooksContactForm-name">Name</label>
          </div>

          <div class="field">
            <input class="field__input" autocomplete="email" type="email" id="HooksContactForm-email" name="contact[email]" value="{{ form.email }}" placeholder="Email" required>
            <label class="field__label" for="HooksContactForm-email">Email *</label>
          </div>

          <div class="field">
            <input class="field__input" autocomplete="tel" type="tel" id="HooksContactForm-phone" name="contact[Phone]" value="{{ form.phone }}" placeholder="Phone">
            <label class="field__label" for="HooksContactForm-phone">Phone</label>
          </div>

          <div class="field">
            <textarea rows="7" id="HooksContactForm-body" class="text-area field__input" name="contact[Message]" placeholder="How can we help?" required>{{ form.body }}</textarea>
            <label class="field__label" for="HooksContactForm-body">How can we help? *</label>
          </div>

          <button type="submit" class="button">Send message</button>
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hooks Contact page",
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Contact HooksLB"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "We’re here to help."},
    {"type": "richtext", "id": "intro", "label": "Introduction", "default": "<p>Have a question about the Hooks belt, your order, or delivery? Send us a message.</p>"},
    {"type": "text", "id": "form_heading", "label": "Form heading", "default": "Send us a message"},
    {"type": "richtext", "id": "form_intro", "label": "Form introduction", "default": "<p>Complete the form and include any details that will help us answer your question.</p>"}
  ],
  "presets": [{"name": "Hooks Contact page"}]
}
{% endschema %}
